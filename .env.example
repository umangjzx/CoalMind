# ─────────────────────────────────────────────────────────────
# CoalMind AI — environment template.  Copy to .env and adjust.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# --- Postgres (used by docker-compose and the backend) ---
POSTGRES_USER=coalmind
POSTGRES_PASSWORD=coalmind
POSTGRES_DB=coalmind
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# SQLAlchemy URL is derived from the parts above by app.core.config,
# override it directly only if you need something non-standard:
# DATABASE_URL=postgresql+psycopg://coalmind:coalmind@localhost:5432/coalmind

# --- MinIO / object storage ---
MINIO_ROOT_USER=coalmind
MINIO_ROOT_PASSWORD=coalmind-secret
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=coalmind-documents
MINIO_SECURE=false

# --- LLM provider ---------------------------------------------------------
# provider: ollama | anthropic
LLM_PROVIDER=ollama
LLM_MODEL=mistral
OLLAMA_BASE_URL=http://localhost:11434
# Only read when LLM_PROVIDER=anthropic AND ALLOW_THIRD_PARTY_API=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Embeddings provider ------------------------------------------------
# provider: fastembed (on-prem, pure-python, no GPU) | ollama (needs an embed model pulled)
EMBED_PROVIDER=fastembed
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384

# --- Data sovereignty gate --------------------------------------------
# When false, any attempt to use a hosted third-party API (Anthropic) is
# refused by the provider factory. Keep false for sensitive corpora.
ALLOW_THIRD_PARTY_API=true

# --- Extraction / review ---------------------------------------------
# Fields scoring below this are routed to the human review queue and may
# not be used in a finalized report.
CONFIDENCE_THRESHOLD=0.75

# --- Auth (full RBAC lands in M6; placeholder secret for now) --------
JWT_SECRET=dev-only-change-me
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=7

# --- API / CORS ----------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Frontend ----------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
